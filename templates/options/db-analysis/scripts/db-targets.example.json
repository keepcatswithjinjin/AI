{
  "targets": [
    {
      "name": "example-readonly",
      "type": "mysql",
      "host": "db.example.internal",
      "port": 3306,
      "database": "",
      "allowedDatabases": ["example_database"],
      "user": "readonly_user",
      "clientDefaultsFile": "",
      "allowOperationalReadonlyGrants": false,
      "connectTimeoutSeconds": 15,
      "queryTimeoutSeconds": 600,
      "maxRows": 1000,
      "note": "Replace locally with a dedicated read-only target. Never commit credentials."
    },
    {
      "name": "example-postgresql-readonly",
      "type": "postgresql",
      "host": "postgres.example.internal",
      "port": 5432,
      "database": "app_prod",
      "allowedDatabases": ["app_prod"],
      "allowedSchemas": ["public"],
      "user": "readonly_user",
      "psqlPath": "",
      "pgPassFile": "",
      "sslMode": "require",
      "connectTimeoutSeconds": 15,
      "queryTimeoutSeconds": 600,
      "maxRows": 1000,
      "note": "Generic PostgreSQL/Hologres readonly target. Keep credentials only in a local pgpass file."
    },
    {
      "name": "example-redis-test",
      "type": "redis",
      "environment": "test",
      "host": "redis.example.internal",
      "port": 6379,
      "redisDb": 0,
      "user": "",
      "redisCliPath": "",
      "redisAuthFile": "",
      "tls": false,
      "allowedKeyPrefixes": ["example:"],
      "maxValueBytes": 65536,
      "note": "Example only. Store credentials in a local private file; only bounded read actions are exposed."
    }
  ]
}
