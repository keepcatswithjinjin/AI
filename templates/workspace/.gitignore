**/accounts.local.json
**/*.local.json
**/maintenance-approval.json
**/local-git-hook-bypass-approval.json
.env
.env.*
!.env.example
# Runtime output
**/__pycache__/
*.py[cod]
**/node_modules/
**/.venv/
*.stackdump
*.bak
*.bak2
*.tmp
*.log
